{
  "name": "agenda-citas",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter web run build",
    "typecheck": "pnpm -r run typecheck",
    "deploy": "pnpm run build && pnpm --filter worker run deploy",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @agenda/db run migrate",
    "db:generate": "pnpm --filter @agenda/db run generate"
  }
}
